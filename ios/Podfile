platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  settings = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  raise 'Run flutter pub get before pod install' unless File.exist?(settings)
  File.foreach(settings) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise 'FLUTTER_ROOT missing from Generated.xcconfig; run flutter pub get'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_ios_podfile_setup

target 'Runner' do
  # IronSourceSDK contains static XCFrameworks, so the plug-in wrappers must
  # also link statically rather than embedding a dynamic framework around them.
  use_frameworks! :linkage => :static
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # The Flutter plug-in pins IronSourceSDK 9.4.0.0. These adapters support 9.x.
  pod 'IronSourceFacebookAdapter', '5.4.0.0'
  pod 'IronSourceChartboostAdapter', '5.10.0.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
