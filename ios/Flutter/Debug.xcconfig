#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Build Debug simulators for the host Mac. Xcode 27's lipo rejects Flutter
// 3.44's combined arm64/x86_64 verification. Device release archives are unchanged.
ARCHS[sdk=iphonesimulator*] = $(NATIVE_ARCH_ACTUAL)
