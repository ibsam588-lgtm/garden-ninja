default_platform(:android)

platform :android do
  desc "Upload Garden Ninja to the Google Play track configured by PLAY_TRACK"
  lane :internal do
    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.gardenninja.garden_ninja"),
      track: ENV.fetch("PLAY_TRACK", "internal"),
      release_status: "completed",
      aab: File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__),
      json_key: File.expand_path("play-store-service-account.json", __dir__),
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end

  desc "Promote an exact tested internal build to Google Play production"
  lane :promote do
    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "com.gardenninja.garden_ninja"),
      json_key: File.expand_path("play-store-service-account.json", __dir__),
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: "completed",
      version_code: Integer(ENV.fetch("PROMOTE_VERSION_CODE"), 10),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end

platform :ios do
  private_lane :connect_api do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      in_house: false
    )
  end

  desc "Choose the next unused TestFlight build number for this version"
  lane :next_build_number do
    latest = latest_testflight_build_number(
      api_key: connect_api,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      version: ENV.fetch("IOS_VERSION"),
      initial_build_number: 0
    )
    File.open(ENV.fetch("GITHUB_OUTPUT"), "a") do |output|
      output.puts("build_number=#{latest.to_i + 1}")
    end
  end

  desc "Upload the signed IPA to App Store Connect for TestFlight"
  lane :testflight do
    upload_to_testflight(
      api_key: connect_api,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      apple_id: ENV.fetch("APP_STORE_ID"),
      ipa: File.expand_path("../build/ios/ipa/GardenNinja.ipa", __dir__),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )
  end

  desc "Submit an existing tested build to App Review, with manual release after approval"
  lane :submit_review do
    upload_to_app_store(
      api_key: connect_api,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
      app_version: ENV.fetch("IOS_VERSION"),
      build_number: ENV.fetch("IOS_BUILD_NUMBER"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
